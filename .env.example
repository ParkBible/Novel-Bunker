# DeepSeek API 키 (서버 전용)
DEEPSEEK_API_KEY=

# Google OAuth (웹 애플리케이션 클라이언트) — Drive 백업 + AI 기능 로그인
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# AI 기능을 쓸 수 있는 구글 계정 (쉼표로 구분)
ALLOWED_EMAILS=you@example.com

# 세션 쿠키 서명용 비밀값, 32자 이상 (예: openssl rand -base64 32)
SESSION_SECRET=
